# kuroshio 設定（3.0；跟 2.x（candydns）同一套欄位）
# 用 LuCI「服務 → 黑潮 DNS」修改；空白的數值參數使用程式內建預設值

config kuroshio 'main'
	option enabled '0'
	option lan_zone 'lan'
	option wan_zone 'wan'
	option redirect 'dnsmasq-upstream'
	option dns_port '5335'
	option listen_ipv6 '1'
	# DNR（RFC 9463）：用 DHCP / RA 告訴區網裝置可以用加密 DNS（需要網域、有效憑證、加密監聽）
	option dnr '1'
	option exchange_port '5354'
	list local_domain 'lan'
	option query_log '0'
	option admin_port '8054'
	option data_dir ''
	# 補跑時段（台北時間，例如 '01:00-06:00'）：剛刷機、學習資料不見、或很久沒跑時的補跑（DNS 評測、CDN 掃描等）
	# 只在這段時間進行，期間先用預設上游；排定時間與手動執行不受影響。空白 = 開機後幾分鐘就補跑
	option catchup_window ''
	# 本程式重新啟動 / 沒有回答時，暫時讓 dnsmasq 直接轉送（裝置一定有 DNS；這段期間沒有過濾）
	option restart_fallback '1'
	# 下面的訂閱清單是哪一版的預設值（升級時 uci-defaults 依此更新沒動過的預設清單，不用手動改）
	option lists_version '3.3'

config doh 'doh'
	option enabled '0'
	option http3 '0'
	option port '8443'
	option open_wan '0'
	option wan_port '443'
	# 多位址監聽（取代 host；IPv4 與 IPv6 可以同時寫）：list binds '0.0.0.0' / list binds '::'
	# DoH3 另外指定位址：list http3_binds '…'；TCP 要不要 TLS：option tls 'auto'（auto / 1 / 0）

config doq 'doq'
	option enabled '0'
	option port '853'

config dot 'dot'
	option enabled '0'
	option port '853'
	option open_wan '0'

config tls 'tls'
	# 綁定網域：固定網域或 DDNS 名稱（公開頁、社群、憑證、DDNS 記錄沒另外填時都用它）
	option domain ''
	# 憑證：acme = acme.sh 申請；manual = 自備憑證（另外寫 option cert / option key，不會被申請或覆蓋）
	option cert_mode 'acme'
	option acme_server 'letsencrypt'
	option acme_key 'ec-256'
	option acme_email ''

config cf_account 'cf_account'
	option api_token ''

config ddns 'ddns'
	option enabled '0'
	option ipv4 '1'
	option ipv6 '0'
	option proxied '0'
	option ttl '1'
	option interval '5'
	option ip_source 'web'
	# 多網卡 / 多出口：每張網卡各自偵測公網 IP，同一個名稱發布多筆記錄
	#	list interfaces 'pppoe-wan'
	#	list interfaces 'wan2'
	# IPv6（AAAA）預設不發布：很多線路（例如中華電信）會擋外面連進來的 IPv6

config site 'site'
	option enabled '0'

config community 'community'
	option enabled '0'
	# ISP 群組（3.5.0）：開了之後好友同步時多帶這台 WAN 的業者群組（例如 cht；只到群組，不含 IP），
	#   好友只拿來決定先驗證誰的候選；開了之後好友會知道你用哪一家業者
	option share_isp_group '0'

# 來源 IP 存取控制（規格 08）：taiwan = 只開放台灣（全部 ISP，預設）、custom = 只開放 list groups 勾選的 ISP、open = 全開放
# list allow / list deny：自訂允許 / 封鎖的 IP 或網段（封鎖勝過一切）；區網永遠可以連
config access 'access'
	option mode 'taiwan'

config upstream 'upstream'
	list fallback 'udp://45.90.30.126'
	list fallback 'udp://1.0.0.2'
	list fallback 'udp://8.8.4.4'
	list bootstrap '1.1.1.1'
	list bootstrap '8.8.8.8'
	list last_resort 'udp://8.8.8.8'
	list last_resort 'udp://1.1.1.1'
	list auto_type 'udp'
	list auto_type 'doh'
	list auto_type 'dot'
	# 路徑檢查（3.3.6）：一般 DNS 被接走、「不存在」被改寫、協定被擋、TLS 攔截、IPv6
	option path_check '1'
	# 一般 DNS 被接走時：skip-plain（評測不測一般 DNS）/ warn（只提醒）/ ignore
	option intercept_policy 'skip-plain'
	# 用 IPv6 連上游：auto（依路由判斷）/ 1 / 0
	option ipv6 'auto'
	# 串接（3.4.0）：辨識上游的黑潮並自動串接、共用它的評測結果與 CDN 節點；關閉 = 自己重做，重複使用網路
	option chain '1'
	# 提供資料給接在後面的黑潮；關閉 = 下游自己重做評測與 CDN 掃描，重複浪費網路資源（含這台的頻寬）
	option allow_downstream '1'

config resolver 'resolver'
	# 背景補問（3.4.0）：只問最快幾台上游時，CDN 相關與抽樣的查詢回答之後在背景問其他上游（不增加等待）
	# cdn = 開（預設）/ off = 不補問（3.3.7 的行為）
	option backfill 'cdn'
	# 非 CDN 的查詢每幾次抽一次補問比對；0 = 不抽樣
	option backfill_sample '16'

config iprank 'iprank'

config filter 'filter'
	option enabled '1'

config filter_list
	option enabled '1'
	option name 'FutaGuard TW165（台灣 165 反詐騙）'
	option url 'https://filter.futa.gg/TW165_abp.txt'
	option category 'malware'

config filter_list
	option enabled '1'
	option name 'FutaGuard TWNIC-RPZ（台灣網路資訊中心停止解析）'
	option url 'https://filter.futa.gg/TWNIC-RPZ_abp.txt'
	option category 'malware'

config filter_list
	option enabled '1'
	option name 'HaGeZi TIF 精簡版（威脅情資）'
	option url 'https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.mini.txt'
	option category 'malware'

config filter_list
	option enabled '0'
	option name 'FutaGuard 新註冊網域（7 天，誤擋風險高）'
	option url 'https://filter.futa.gg/nrd/past-07day_abp.txt'
	option category 'malware'

config filter_list
	option enabled '1'
	option name 'FutaGuard LowTechHost（台灣廣告）'
	option url 'https://filter.futa.gg/hosts_abp.txt'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'CHN: anti-AD'
	option url 'https://adguardteam.github.io/HostlistsRegistry/assets/filter_21.txt'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'EasyList China'
	option url 'https://easylist-downloads.adblockplus.org/easylistchina.txt'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'OISD small'
	option url 'https://small.oisd.nl/'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'HaGeZi Light'
	option url 'https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/light.txt'
	option category 'ads'

config filter_list
	option enabled '0'
	option name '內容農場終結者'
	option url 'https://danny0838.github.io/content-farm-terminator/files/blocklist/content-farms.txt'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'a-dove-is-dumb（Adobe 遙測）'
	option url 'https://a.dove.isdumb.one/cdn'
	option category 'telemetry'

config filter_list
	option enabled '1'
	option name 'blocklistproject smart-tv（電視遙測）'
	option url 'https://raw.githubusercontent.com/blocklistproject/Lists/master/smart-tv.txt'
	option category 'telemetry'

config filter_list
	option enabled '0'
	option name 'Ruddernation（Adobe 驗證，會擋 Adobe 正版啟用）'
	option url 'https://raw.githubusercontent.com/Ruddernation-Designs/Adobe-URL-Block-List/master/hosts'
	option category 'telemetry'

# 以下是預設不勾選的大清單：記憶體很多、要更完整的廣告與資安防護（例如企業）時再開
config filter_list
	option enabled '0'
	option name 'HaGeZi Pro++（廣告追蹤加強版，約 27 萬條）'
	option url 'https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.plus.txt'
	option category 'ads'

config filter_list
	option enabled '0'
	option name 'AdGuard DNS filter（約 19 萬條）'
	option url 'https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt'
	option category 'ads'

config filter_list
	option enabled '0'
	option name 'HaGeZi TIF 完整版（威脅情資，約 146 萬條、15 MB 記憶體）'
	option url 'https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.txt'
	option category 'malware'

config filter_list
	option enabled '0'
	option name 'HaGeZi 加密 DNS／VPN／代理繞過（企業用：裝置無法自己改用其他 DNS）'
	option url 'https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/doh-vpn-proxy-bypass.txt'
	option category 'malware'
	# 繞過防護類的清單（3.4.0）：上游的 allow_downstream 開著時，不擋已登記的下游黑潮解析它自己的上游主機名稱
	option bypass '1'

config cdn 'cdn'
	option enabled '1'
	# 線路感知（3.5.0，進階，預設都開；要關才寫 '0'）：
	#   pop_audit：上游給的節點以本機量到的機房為準（串接中搭既有的抽查，一天最多 24 個請求）
	#   pop_switch：到得了兩個以上台灣機房時，持續變差的機房暫時排到後面（4 小時後恢復）
	#   spread_prefixes：回給裝置的幾個節點盡量分在不同網段
	#   slower_fallback：台灣節點實測明顯比原本慢時，那個網站暫時用原本的答案（6 小時後重測）
	# option pop_audit '1'
	# option pop_switch '1'
	# option spread_prefixes '1'
	# option slower_fallback '1'

config cdn_provider 'cloudflare'
	option enabled '1'
	list seed_v4 '104.16.161.36'
	list seed_v4 '104.18.20.216'
	list seed_v4 '104.17.75.150'
	list seed_v4 '162.159.235.5'
	list seed_v4 '172.67.98.180'
	list seed_v4 '172.67.78.23'
	list seed_v4 '104.25.157.27'
	list seed_v4 '172.67.125.25'
	list seed_v4 '141.101.113.37'
	list seed_v4 '162.159.2.218'
	list seed_v4 '173.245.59.168'
	list seed_v4 '198.41.208.107'

config cdn_provider 'cloudfront'
	option enabled '1'
	list seed_v4 '3.169.37.27'
	list seed_v4 '65.9.172.103'
	list seed_v4 '54.192.42.186'
	list seed_v4 '13.33.29.112'

config cdn_provider 'fastly'
	option enabled '1'

config cdn_provider 'gcore'
	option enabled '1'

config cdn_provider 'azure'
	option enabled '1'

config cdn_provider 'akamai'
	option enabled '1'
	option ecs '1'

config cdn_provider 'edgio'
	option enabled '1'
	option ecs '1'

config cdn_provider 'cdnetworks'
	option enabled '1'
	option ecs '1'

config cdn_provider 'tencent'
	option enabled '1'
	option ecs '1'

config cdn_provider 'alibaba'
	option enabled '1'
	option ecs '1'

config cdn_provider 'wangsu'
	option enabled '1'
	option ecs '1'

config cdn_provider 'bytedance'
	option enabled '1'
	option ecs '1'

config cdn_provider 'apple'
	option enabled '1'
	option ecs '1'

config ecs 'ecs'
	list resolver 'udp://8.8.8.8'
	list resolver 'udp://8.8.4.4'
	list tw_subnet '168.95.0.0/24'
	list tw_subnet '1.160.0.0/24'
	list tw_subnet '139.175.0.0/24'
	list tw_subnet '140.112.0.0/24'
	list tw_subnet '35.229.0.0/24'

config job 'dns_benchmark'
	option enabled '1'
	list at '04:10'

config job 'cdn_ranges'
	option enabled '1'
	list at '03:10'
	list weekday '0'

config job 'cdn_scan'
	option enabled '1'
	list at '03:20'
	list weekday '0'

config job 'cdn_pool'
	option enabled '1'
	list at '05:30'

config benchmark 'benchmark'
	# 上游多樣性（3.4.0）：near = 覆蓋上游先選鄰近的（台灣、日本、香港、新加坡或延遲低）；any = 不分遠近（3.3.7 的行為）
	option coverage_region 'near'
	# 最低延遲在這以內（毫秒）就算鄰近
	option near_max_ms '60'
	# 分級評測（3.5.0）：auto = 記憶體小於 256 MB 只測 A 級（經營者明確的），其他全部測；a = 只測 A 級；ab = 全部測
	#   只測 A 級時，使用者自己加的照測，B 級每天補位（最多 32 個）與輪流探索（40 個），不是不評測
	option tiers 'auto'
	# 惡意網站探測（3.5.0）：判出有擋惡意網站的 DNS、不選來用。附帶的 probe.txt 是空的時整段不跑；
	#   評測只做 DNS 查詢、不連線，但查這類網域可能被上游或線路上的資安設備記錄，不想要就設 0
	option malware_probe '1'

config scan 'scan'

config pool 'pool'

# 硬體等級：auto（依記憶體自動判斷）/ tiny / small / standard / large
config system 'system'
	option profile 'auto'
