# kuroshio 設定（3.0；跟 2.x（candydns）同一套欄位）
# 用 LuCI「服務 → 黑潮 DNS」修改；空白的數值參數使用程式內建預設值

config kuroshio 'main'
	option enabled '0'
	option lan_zone 'lan'
	option wan_zone 'wan'
	option redirect 'dnsmasq-upstream'
	option dns_port '5335'
	option listen_ipv6 '1'
	# DNR（RFC 9463）：用 DHCP / RA 告訴區網裝置可以用加密 DNS（需要網域、有效憑證、加密監聽）
	option dnr '1'
	option exchange_port '5354'
	list local_domain 'lan'
	option query_log '0'
	option admin_port '8054'
	option data_dir ''

config doh 'doh'
	option enabled '0'
	option http3 '0'
	option port '8443'
	option open_wan '0'
	option wan_port '443'

config doq 'doq'
	option enabled '0'
	option port '853'

config dot 'dot'
	option enabled '0'
	option port '853'
	option open_wan '0'

config tls 'tls'
	option domain ''
	option cert_mode 'acme'
	option acme_server 'letsencrypt'
	option acme_key 'ec-256'
	option acme_email ''

config cf_account 'cf_account'
	option api_token ''

config ddns 'ddns'
	option enabled '0'
	option ipv4 '1'
	option ipv6 '0'
	option proxied '0'
	option ttl '1'
	option interval '5'
	option ip_source 'web'

config site 'site'
	option enabled '0'

config community 'community'
	option enabled '0'

config upstream 'upstream'
	list fallback 'udp://45.90.30.126'
	list fallback 'udp://1.0.0.2'
	list fallback 'udp://8.8.4.4'
	list bootstrap '1.1.1.1'
	list bootstrap '8.8.8.8'
	list last_resort 'udp://8.8.8.8'
	list last_resort 'udp://1.1.1.1'
	list auto_type 'udp'
	list auto_type 'doh'
	list auto_type 'dot'

config resolver 'resolver'

config iprank 'iprank'

config filter 'filter'
	option enabled '1'

config filter_list
	option enabled '1'
	option name 'EasyList China'
	option url 'https://easylist-downloads.adblockplus.org/easylistchina.txt'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'CHN: anti-AD'
	option url 'https://adguardteam.github.io/HostlistsRegistry/assets/filter_21.txt'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'FutaGuard LowTechHost（台灣廣告）'
	option url 'https://filter.futa.gg/hosts_abp.txt'
	option category 'ads'

config filter_list
	option enabled '0'
	option name 'blocklistproject tracking'
	option url 'https://raw.githubusercontent.com/blocklistproject/Lists/master/tracking.txt'
	option category 'ads'

config filter_list
	option enabled '0'
	option name '內容農場終結者'
	option url 'https://danny0838.github.io/content-farm-terminator/files/blocklist/content-farms.txt'
	option category 'ads'

config filter_list
	option enabled '1'
	option name 'a-dove-is-dumb（Adobe 遙測）'
	option url 'https://raw.githubusercontent.com/ignaciocastro/a-dove-is-dumb/main/list.txt'
	option category 'telemetry'

config filter_list
	option enabled '1'
	option name 'Ruddernation（Adobe 驗證）'
	option url 'https://raw.githubusercontent.com/Ruddernation-Designs/Adobe-URL-Block-List/master/hosts'
	option category 'telemetry'

config filter_list
	option enabled '1'
	option name 'blocklistproject smart-tv（電視遙測）'
	option url 'https://raw.githubusercontent.com/blocklistproject/Lists/master/smart-tv.txt'
	option category 'telemetry'

config filter_list
	option enabled '0'
	option name 'blocklistproject adobe（會擋 Adobe 登入）'
	option url 'https://raw.githubusercontent.com/blocklistproject/Lists/master/adobe.txt'
	option category 'telemetry'

config filter_list
	option enabled '1'
	option name 'FutaGuard TW165（台灣 165 反詐騙）'
	option url 'https://filter.futa.gg/TW165_abp.txt'
	option category 'malware'

config filter_list
	option enabled '0'
	option name 'HaGeZi'\''s Threat Intelligence Feeds'
	option url 'https://adguardteam.github.io/HostlistsRegistry/assets/filter_44.txt'
	option category 'malware'

config filter_list
	option enabled '0'
	option name 'FutaGuard 新註冊網域（7 天，誤擋風險高）'
	option url 'https://filter.futa.gg/nrd/past-07day_abp.txt'
	option category 'malware'

config cdn 'cdn'
	option enabled '1'

config cdn_provider 'cloudflare'
	option enabled '1'
	list seed_v4 '104.16.161.36'
	list seed_v4 '104.18.20.216'
	list seed_v4 '104.17.75.150'
	list seed_v4 '162.159.235.5'
	list seed_v4 '172.67.98.180'
	list seed_v4 '172.67.78.23'
	list seed_v4 '104.25.157.27'
	list seed_v4 '172.67.125.25'
	list seed_v4 '141.101.113.37'
	list seed_v4 '162.159.2.218'
	list seed_v4 '173.245.59.168'
	list seed_v4 '198.41.208.107'

config cdn_provider 'cloudfront'
	option enabled '1'
	list seed_v4 '3.169.37.27'
	list seed_v4 '65.9.172.103'
	list seed_v4 '54.192.42.186'
	list seed_v4 '13.33.29.112'

config cdn_provider 'fastly'
	option enabled '1'

config cdn_provider 'gcore'
	option enabled '1'

config cdn_provider 'azure'
	option enabled '1'

config cdn_provider 'akamai'
	option enabled '1'
	option ecs '1'

config cdn_provider 'edgio'
	option enabled '1'
	option ecs '1'

config cdn_provider 'cdnetworks'
	option enabled '1'
	option ecs '1'

config cdn_provider 'tencent'
	option enabled '1'
	option ecs '1'

config cdn_provider 'alibaba'
	option enabled '1'
	option ecs '1'

config cdn_provider 'wangsu'
	option enabled '1'
	option ecs '1'

config cdn_provider 'bytedance'
	option enabled '1'
	option ecs '1'

config cdn_provider 'apple'
	option enabled '1'
	option ecs '1'

config ecs 'ecs'
	list resolver 'udp://8.8.8.8'
	list resolver 'udp://8.8.4.4'
	list tw_subnet '168.95.0.0/24'
	list tw_subnet '1.160.0.0/24'
	list tw_subnet '139.175.0.0/24'
	list tw_subnet '140.112.0.0/24'
	list tw_subnet '35.229.0.0/24'

config job 'dns_benchmark'
	option enabled '1'
	list at '04:10'

config job 'cdn_ranges'
	option enabled '1'
	list at '03:10'
	list weekday '0'

config job 'cdn_scan'
	option enabled '1'
	list at '03:20'
	list weekday '0'

config job 'cdn_pool'
	option enabled '1'
	list at '05:30'

config benchmark 'benchmark'

config scan 'scan'

config pool 'pool'

# 硬體等級：auto（依記憶體自動判斷）/ tiny / small / standard / large
config system 'system'
	option profile 'auto'
