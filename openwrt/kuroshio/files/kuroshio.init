#!/bin/sh /etc/rc.common
# kuroshio — 黑潮 DNS（Kuroshio DNS）：區網 DNS · DoH / DoT / DoQ / DoH3 · 廣告過濾 · CDN 台灣節點

START=19
STOP=89
USE_PROCD=1

BIN=/usr/bin/kuroshio
SHARE=/usr/share/kuroshio
ETC=/etc/kuroshio
RUN=/var/run/kuroshio
LIBEXEC=/usr/libexec/kuroshio

# 第一次啟動：放入可編輯的評測名單（之後由 LuCI 修改，不會被覆蓋）；自訂規則由程式自己補
seed_files() {
	local f
	mkdir -p "$ETC/benchmark"
	for f in "$SHARE"/benchmark/*; do
		[ -e "$f" ] || continue
		[ -e "$ETC/benchmark/${f##*/}" ] || cp -a "$f" "$ETC/benchmark/"
	done
}

start_service() {
	local enabled
	config_load kuroshio
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		# 停用：procd 會在這之後停掉執行中的程式，等它放開 53 埠再還原 dnsmasq
		( sleep 3; "$LIBEXEC/takeover.sh" revert ) </dev/null >/dev/null 2>&1 &
		"$LIBEXEC/acme.sh" cron-sync
		return 0
	fi

	mkdir -p "$RUN"
	umask 077   # uci.json 含 Cloudflare API Token
	ubus call uci get '{"config":"kuroshio"}' > "$RUN/uci.json" || return 1
	umask 022
	seed_files
	"$LIBEXEC/takeover.sh" apply
	"$LIBEXEC/acme.sh" cron-sync

	# 區網 IPv4 與 ULA：積極劫持 / 取代 dnsmasq 模式下直接綁在這兩個位址上（位址變了 env 不同，procd 自動重啟）
	local lan4 ula
	. "$LIBEXEC/lan.sh"
	lan4=$(lan_ip4)
	ula=$(lan_ula6)

	procd_open_instance kuroshio
	procd_set_param command "$BIN" run --uci
	procd_set_param env KUROSHIO_UCI_JSON="$RUN/uci.json" KUROSHIO_ETC="$ETC" KUROSHIO_SHARE="$SHARE" \
		KUROSHIO_LAN_IP4="$lan4" KUROSHIO_LAN_ULA="$ula" NO_COLOR=1
	# 背景工作（網段掃描）同時開很多連線
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	# 停止時給程式時間把快照寫出（Flash 寫入保護：關機時一定寫出）
	procd_set_param term_timeout 15
	procd_set_param file /etc/config/kuroshio
	procd_close_instance
}

# 程式停止後才還原 dnsmasq（取代 dnsmasq 模式下要等它放開 53 埠）
service_stopped() {
	sleep 1
	"$LIBEXEC/takeover.sh" revert
}

service_triggers() {
	procd_add_reload_trigger kuroshio
	# 區網介面變動（例如剛建立 ULA、改了區網 IP）：重新套用 DNS 接管與綁定位址
	procd_add_interface_trigger "interface.*" lan /etc/init.d/kuroshio reload
}
