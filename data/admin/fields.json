{
  "version": 1,
  "about": "Windows 設定頁的欄位定義（規格 02 第 7.2 節）。key = config.json 的路徑；預設值一律由伺服器提供（/api/config 的 defaults），這裡不重複。type：bool / int / float / port / text / password / path / host / select / list（一行一個）/ multi（多選）/ table（物件陣列）。pro = 只在「專業」模式顯示。fallbackDefault = 伺服器的預設值沒有這個欄位時，程式內建的行為（只用來顯示）。dependsOn = 另一個欄位是指定值時才顯示。",
  "groups": [
    {
      "id": "listen",
      "title": "服務與監聽",
      "desc": "一般 DNS、DoH、DoH3、DoT、DoQ 的埠號與憑證。儲存後服務會在程式內重新啟動，大約 1 秒。",
      "notice": true,
      "sections": [
        {
          "title": "一般 DNS（UDP / TCP）",
          "fields": [
            { "key": "listen.plain.enabled", "type": "bool", "label": "啟用一般 DNS", "pro": true },
            { "key": "listen.plain.port", "type": "port", "label": "DNS 埠號", "help": "本程式聽的埠。要讓這台電腦或區網裝置直接把 DNS 指過來，請保持 53。" },
            { "key": "listen.plain.binds", "type": "list", "label": "監聽位址", "help": "一行一個 IP。127.0.0.1 = 只給這台電腦用；填這台電腦的區網 IP（例如 192.168.1.10）或 0.0.0.0，區網裝置也能使用。", "placeholder": "127.0.0.1" },
            { "key": "listen.plain.allowFrom", "type": "list", "label": "允許查詢的來源", "help": "區網 DNS 只回答這些網段（空白用預設的私有網段）。", "pro": true, "placeholder": "192.168.0.0/16" }
          ]
        },
        {
          "title": "DNS over HTTPS（DoH / DoH3）",
          "desc": "網址是 https://網域/dns-query。需要先設定網域與憑證；只在這台電腦或區網使用的話不必打開。",
          "fields": [
            { "key": "listen.doh.enabled", "type": "bool", "label": "啟用" },
            { "key": "listen.doh.windowsMode", "type": "select", "label": "跟 IIS 共用 443 的方式", "fallbackDefault": "auto", "help": "TCP 443 被 IIS（HTTP.sys）占用時怎麼處理。UDP 443（DoH3）、DoT、DoQ 跟 IIS 無關，一律由黑潮 DNS 自己監聽。只有 Windows 有效。", "options": [
              { "value": "auto", "label": "自動（443 沒被占用就獨立監聽，被 IIS 占用就跟 HTTP.sys 共用）" },
              { "value": "standalone", "label": "獨立（沒有 IIS，黑潮 DNS 自己聽 443）" },
              { "value": "httpsys", "label": "HTTP.sys 共用（有 IIS 時建議，只登記自己的網址）" },
              { "value": "iis-proxy", "label": "IIS 反向代理（沿用 2.x 的 ARR 設定，IIS 轉給本機埠）" }
            ] },
            { "key": "listen.doh.port", "type": "port", "label": "監聽埠號", "help": "IIS 反向代理模式由 IIS 轉到這個本機埠；沒有 IIS、要直接對外時改成 443。" },
            { "key": "listen.doh.host", "type": "host", "label": "監聽位址", "help": "127.0.0.1 = 只接受本機（IIS 反向代理用）；直接對外時改成 0.0.0.0。", "placeholder": "0.0.0.0" },
            { "key": "listen.doh.http3", "type": "bool", "label": "HTTP/3（DoH3）", "help": "同一個埠號的 UDP 也提供 DoH3（QUIC），掉包環境比較穩。DoH 回應會帶 Alt-Svc 告訴用戶端。路由器的埠轉發記得也要加 UDP。" },
            { "key": "listen.doh.http3Port", "type": "port", "label": "DoH3 改用的 UDP 埠", "help": "UDP 443 被其他程式占用時改用其他埠（例如 8443）。0 = 跟 DoH 同一個埠。", "pro": true, "allowZero": true },
            { "key": "listen.doh.altSvcPort", "type": "port", "label": "Alt-Svc 對外埠號", "help": "外面看到的埠號跟監聽的不同（例如路由器把 443 轉到 8443）時填外面的埠號。0 = 自動。", "pro": true, "allowZero": true },
            { "key": "listen.doh.path", "type": "text", "label": "路徑", "pro": true },
            { "key": "listen.doh.trustProxy", "type": "bool", "label": "信任 X-Forwarded-For", "help": "只有前面還有反向代理（例如 IIS 反向代理模式）時才打開，否則用戶端可以偽造來源 IP。只信任來自 127.0.0.1 的代理。", "pro": true }
          ]
        },
        {
          "title": "DNS over TLS（DoT）",
          "desc": "Android「私人 DNS」用這個。同樣需要網域與憑證。",
          "fields": [
            { "key": "listen.dot.enabled", "type": "bool", "label": "啟用" },
            { "key": "listen.dot.port", "type": "port", "label": "監聽埠號" },
            { "key": "listen.dot.host", "type": "host", "label": "監聽位址", "pro": true }
          ]
        },
        {
          "title": "DNS over QUIC（DoQ）",
          "desc": "UDP 853，延遲最低；AdGuard 系列 App 支援。跟 DoT 共用憑證。",
          "fields": [
            { "key": "listen.doq.enabled", "type": "bool", "label": "啟用" },
            { "key": "listen.doq.port", "type": "port", "label": "監聽埠號（UDP）", "pro": true },
            { "key": "listen.doq.host", "type": "host", "label": "監聽位址", "pro": true }
          ]
        },
        {
          "title": "憑證檔",
          "desc": "用內建 ACME 自動申請（「憑證」分頁）時保持空白；自己有憑證時填 PEM 檔的完整路徑。",
          "fields": [
            { "key": "listen.doh.cert", "type": "path", "label": "DoH 憑證檔（含中繼憑證）", "placeholder": "C:\\ProgramData\\kuroshio\\cert.pem" },
            { "key": "listen.doh.key", "type": "path", "label": "DoH 私鑰檔", "placeholder": "C:\\ProgramData\\kuroshio\\key.pem" },
            { "key": "listen.dot.cert", "type": "path", "label": "DoT / DoQ 憑證檔（含中繼憑證）", "placeholder": "C:\\ProgramData\\kuroshio\\cert.pem" },
            { "key": "listen.dot.key", "type": "path", "label": "DoT / DoQ 私鑰檔", "placeholder": "C:\\ProgramData\\kuroshio\\key.pem" }
          ]
        },
        {
          "title": "其他",
          "fields": [
            { "key": "listen.ddr", "type": "bool", "label": "自動發現（DDR）", "help": "區網裝置（Windows 11、iPhone、Mac）會自動改用 DoH / DoT / DoQ 加密連線，不用手動設定。需要設定網域並開啟至少一種加密協議。" },
            { "key": "listen.proxyProtocol", "type": "bool", "label": "PROXY protocol v2", "help": "前面有支援 PROXY protocol 的負載平衡器時才打開，用來取得真實的用戶端 IP。", "pro": true },
            { "key": "admin.port", "type": "port", "label": "設定頁埠號", "help": "這個設定頁與管理 API 的埠號，只綁 127.0.0.1。改了之後要用新的網址開啟設定頁。", "pro": true }
          ]
        }
      ]
    },
    {
      "id": "upstream",
      "title": "上游",
      "desc": "格式：udp://IP、tcp://IP、tls://主機、https://主機/dns-query、quic://主機、h3://主機/dns-query。每日評測會自動選出最佳組合，以下是固定參與與備援。",
      "sections": [
        {
          "title": "上游 DNS",
          "fields": [
            { "key": "upstream.pinned", "type": "list", "label": "固定上游", "help": "每次查詢都參與、不會被評測淘汰。不要填這台電腦自己。", "placeholder": "udp://1.1.1.1" },
            { "key": "upstream.fallback", "type": "list", "label": "備援", "help": "固定與自動上游都失敗時才用。" },
            { "key": "upstream.bootstrap", "type": "list", "label": "Bootstrap", "help": "解析 DoH / DoT 上游主機名稱用，只能填 IP。", "pro": true },
            { "key": "resolver.lastResort", "type": "list", "label": "最後手段", "help": "所有上游都沒回應時。", "pro": true },
            { "key": "upstream.autoMax", "type": "int", "label": "自動上游最多幾台", "pro": true, "min": 0 },
            { "key": "upstream.autoTypes", "type": "multi", "label": "自動上游可用協定", "pro": true, "options": [
              { "value": "udp", "label": "UDP" },
              { "value": "doh", "label": "DoH" },
              { "value": "doh3", "label": "DoH3" },
              { "value": "dot", "label": "DoT" },
              { "value": "doq", "label": "DoQ" }
            ] }
          ]
        },
        {
          "title": "解析行為",
          "pro": true,
          "fields": [
            { "key": "resolver.timeoutMs", "type": "int", "label": "上游逾時（毫秒）", "min": 1 },
            { "key": "resolver.collectWindowMs", "type": "int", "label": "收集其他上游答案的時間（毫秒）", "help": "第一個回應之後再等多久，用來合併 IP 測速。", "min": 0 },
            { "key": "resolver.fastPath", "type": "bool", "label": "先回第一個正常回應" },
            { "key": "resolver.fastPathTtl", "type": "int", "label": "快速回應的 TTL（秒）", "help": "測速排序完成後，下一次查詢就拿到最佳 IP。", "min": 0 },
            { "key": "resolver.rankIps", "type": "bool", "label": "合併所有上游 IP 並測速排序" },
            { "key": "resolver.maxIps", "type": "int", "label": "每個回應最多幾個 IP", "min": 1 },
            { "key": "resolver.maxTtl", "type": "int", "label": "TTL 上限（秒）", "min": 0 },
            { "key": "resolver.minTtl", "type": "int", "label": "TTL 下限（秒）", "min": 0 },
            { "key": "resolver.negativeMaxTtl", "type": "int", "label": "不存在網域的 TTL 上限（秒）", "min": 0 },
            { "key": "resolver.serveStaleSec", "type": "int", "label": "過期後仍可先回舊資料（秒）", "min": 0 },
            { "key": "resolver.prefetchThresholdSec", "type": "int", "label": "剩餘 TTL 低於幾秒就預取", "min": 0 },
            { "key": "resolver.prefetchRecentSec", "type": "int", "label": "最近幾秒內有人查才預取", "min": 0 },
            { "key": "resolver.cacheMax", "type": "int", "label": "快取筆數上限", "min": 0 },
            { "key": "resolver.sendEcs", "type": "bool", "label": "對上游附帶 ECS（本機對外 IP 的 /24）" },
            { "key": "resolver.stripEch", "type": "bool", "label": "移除 HTTPS 記錄的 ECH", "help": "某些網路環境下 ECH 會讓網站連不上時再打開。" },
            { "key": "resolver.dnssec", "type": "bool", "label": "本機 DNSSEC 驗證" },
            { "key": "resolver.cookies", "type": "bool", "label": "DNS Cookies" }
          ]
        },
        {
          "title": "IP 測速",
          "desc": "以 TCP 連線測量每個 IP 的延遲。",
          "pro": true,
          "fields": [
            { "key": "iprank.port", "type": "port", "label": "測速埠號" },
            { "key": "iprank.timeoutMs", "type": "int", "label": "逾時（毫秒）", "min": 1 },
            { "key": "iprank.okTtlSec", "type": "int", "label": "成功結果保留（秒）", "min": 0 },
            { "key": "iprank.failTtlSec", "type": "int", "label": "失敗結果保留（秒）", "min": 0 },
            { "key": "iprank.concurrency", "type": "int", "label": "同時測速數", "min": 1 }
          ]
        }
      ]
    },
    {
      "id": "filter",
      "title": "過濾",
      "desc": "判定順序：自訂規則是最高原則，命中就不看任何訂閱清單（白名單 @@ 也會蓋過所有清單）；沒有命中才看訂閱清單。支援 AdGuard / hosts 語法，也會檢查 CNAME 鏈。",
      "sections": [
        {
          "title": "過濾",
